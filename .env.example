# Absolute origin of the deployed site, with no trailing slash.
# Canonical URLs, Open Graph tags, robots.txt and sitemap.xml are resolved
# against this value. If it is unset the app falls back to https://piqiz.com
# (see lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://piqiz.com

# Speechmatics API key used by /api/key to mint short-lived realtime tokens.
SPEECHMATICS_SECRET_KEY=
